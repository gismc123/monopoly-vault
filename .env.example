# Copy this file to .env and change the values marked CHANGE ME.
# Never commit your real .env file.

# --- Database ---------------------------------------------------------
POSTGRES_USER=vault
POSTGRES_DB=vault
# CHANGE ME: any long random string
POSTGRES_PASSWORD=change-me-db-password

# --- Auth -------------------------------------------------------------
# CHANGE ME: generate one with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
# How long a login lasts before you must sign in again (hours)
JWT_EXPIRE_HOURS=720
# Set to false once your household has created its accounts
ALLOW_SIGNUP=true

# --- Season -----------------------------------------------------------
# Which season file in api/app/seasons/ is active (e.g. 2026 -> 2026.json)
CAMPAIGN_YEAR=2026

# --- Photo storage ----------------------------------------------------
# Where original sticker photos are kept. The default "photos" is a Docker
# named volume. To use a NAS or any host folder, set an absolute path, e.g.
# PHOTOS_PATH=/mnt/nas/monopoly-vault/photos
PHOTOS_PATH=photos
# Largest photo upload accepted (megabytes)
MAX_UPLOAD_MB=12
