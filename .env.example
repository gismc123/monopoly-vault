# Copy this file to .env and change the values marked CHANGE ME.
# Never commit your real .env file.

# --- Database ---------------------------------------------------------
POSTGRES_USER=vault
POSTGRES_DB=vault
# CHANGE ME: any long random string
POSTGRES_PASSWORD=change-me-db-password

# --- Auth -------------------------------------------------------------
# CHANGE ME: generate one with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
# How long a login lasts before you must sign in again (hours)
JWT_EXPIRE_HOURS=720
# Set to false once your household has created its accounts
ALLOW_SIGNUP=true

# Sign-in protection. After this many failed sign-ins for one username (or from
# one IP address) within the window, sign-in pauses until the window passes.
LOGIN_MAX_FAILURES=10
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_WINDOW_MINUTES=15
# New accounts allowed per IP address per hour
SIGNUPS_PER_IP_PER_HOUR=10

# --- Terms of Service & Privacy Policy --------------------------------
# Who runs this copy of Monopoly Vault, and how users can reach you.
# Shown on the /terms and /privacy pages.
OPERATOR_NAME=
OPERATOR_CONTACT=

# --- Season -----------------------------------------------------------
# Which season file in api/app/seasons/ is active (e.g. 2026 -> 2026.json)
CAMPAIGN_YEAR=2026

# --- Photo storage ----------------------------------------------------
# Where original sticker photos are kept. The default "photos" is a Docker
# named volume. To use a NAS or any host folder, set an absolute path, e.g.
# PHOTOS_PATH=/mnt/nas/monopoly-vault/photos
PHOTOS_PATH=photos
# Largest photo upload accepted (megabytes)
MAX_UPLOAD_MB=12
# Photos uploaded but never saved with a code are deleted after this many hours
UNCLAIMED_PHOTO_HOURS=24
